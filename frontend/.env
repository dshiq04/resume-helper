# 应用元信息（修改后需重新构建；运行时由前端发送给后端，发布目录无需携带本文件）
#
# 版本号：设置页、健康检查 / 系统信息接口和备份文件都会使用该值
APP_VERSION=1.2.1

# 英文应用名称：窗口/进程标识等
APP_NAME=ResumeTrail

# 应用显示名称：窗口标题、托盘菜单、桌面快捷方式名称
APP_TITLE=履途 ResumeTrail

# 默认界面语言：zh-CN | zh-TW | en | ja | ko
APP_DEFAULT_LANGUAGE=zh-CN

# # 开发中水印开关：true 开启，false 关闭（修改后需重新构建/重启开发服务器）
# VITE_SHOW_DEVELOPMENT_WATERMARK=false

